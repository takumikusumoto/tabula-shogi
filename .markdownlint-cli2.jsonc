{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD024": {
      "siblings_only": true
    },
    "MD034": false,
    "MD036": false,
    "MD041": false,
    "MD025": false,
    "MD026": {
      "punctuation": ".,;:!"
    }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "target/**",
    "node_modules/**"
  ]
}
