{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD024": {
      "siblings_only": true
    },
    "MD034": false,
    "MD036": false,
    "MD041": false,
    "MD026": {
      "punctuation": ".,;:!"
    }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "target/**",
    ".artifacts/**",
    "node_modules/**",
    "AGENTS.md",
    "output/**"
  ]
}
